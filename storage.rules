rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de perfil: públicas para mostrarlas en el marketplace, pero solo el dueño
    // puede subir/reemplazar la suya.
    match /profilePhotos/{uid}.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Documentos de verificación de identidad: sensibles, solo el dueño puede subir
    // y solo el dueño puede leer sus propios archivos (el panel de moderación admin
    // usa el Admin SDK, que no pasa por estas reglas).
    match /verifications/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
