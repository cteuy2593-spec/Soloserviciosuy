# Copiá este archivo a ".env" (en la raíz del proyecto) y completá los valores
# con los datos de tu proyecto de Firebase: Consola de Firebase > Configuración
# del proyecto > Tus apps > Configuración del SDK.
#
# Expo expone automáticamente al cliente cualquier variable que empiece con
# EXPO_PUBLIC_ (ver https://docs.expo.dev/guides/environment-variables/).
# Estas claves son seguras de exponer en el cliente: la seguridad real de
# Firebase la dan las Firestore/Storage Security Rules (firestore.rules,
# storage.rules), no el secreto de esta configuración.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Estas dos NO van en el cliente, son solo para las Cloud Functions
# (se configuran con `firebase functions:secrets:set`, ver functions/README).
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
